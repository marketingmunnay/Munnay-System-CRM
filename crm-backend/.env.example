# Copiar este archivo a .env y completar valores
# Nunca commitees .env con credenciales reales

# URL de conexión a Postgres (producción)
# Ejemplos:
# - Sin SSL (misma VM / red privada)
# DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/munnay_db"
# - Con SSL
# DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/munnay_db?sslmode=require"
DATABASE_URL="postgresql://user:pass@host:5432/munnay_db"

# Secreto para firmar JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro"

# Orígenes permitidos separados por coma
# ALLOWED_ORIGINS="https://crm.tu-dominio.com,https://tu-frontend.vercel.app"
