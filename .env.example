# Frontend (Vite) - Variables de entorno

# URL base de la API del backend
# Ejemplos:
# VITE_API_URL="https://crm.munnaymedicinaestetica.com/api"
# VITE_API_URL="https://munnay-system.vercel.app/api" # si el dominio proxy al backend
# VITE_API_URL="http://157.173.119.186:4000/api" # IP:puerto (no recomendado a largo plazo)
VITE_API_URL="https://munnay-system.vercel.app"

# Nota: si no defines VITE_API_URL, el frontend usará automáticamente
# window.location.origin y añadirá "/api" al final.